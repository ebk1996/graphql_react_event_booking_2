server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /graphql {
        proxy_pass http://backend:3000/graphql;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $re        proxy_set_header X-Forwarded-Proto $scheme;

