const mongoose = require('mongoose');
const Schema = mongoose.Schema;

const userSchema = new Schema(
  {
    firstName: {
      type: String,
      trim: true,
      default: '',
    },

    lastName: {
      type: String,
      trim: true,
      default: '',
    },

    phone: {
      type: String,
      trim: true,
      default: '',
    },

    zipCode: {
      type: String,
      required: true,
      trim: true,
      match: /^\d{5}$/,
    },

    email: {
      type: String,
      required: true,
      unique: true,
      lowercase: true,
      trim: true,
    },

    password: {
      type: String,
      required: true,
    },

    profileImage: {
      type: String,
      default: '',
    },

    bio: {
      type: String,
      default: '',
      maxlength: 500,
    },

    followers: [
      {
        type: Schema.Types.ObjectId,
        ref: 'User',
      },
    ],

    following: [
      {
        type: Schema.Types.ObjectId,
        ref: 'User',
      },
    ],

    createdEvents: [
      {
        type: Schema.Types.ObjectId,
        ref: 'Event',
      },
    ],
  },
  { timestamps: true }
);

module.exports =
  mongoose.models.User ||
  mongoose.model('User', userSchema);
