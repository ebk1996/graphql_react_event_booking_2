const mongoose = require('mongoose');

const commentSchema = new mongoose.Schema(
    {
        event: {
            type: mongoose.Schema.Types.ObjectId,
            ref: 'Event',
            required: true,
        },

        user: {
            type: mongoose.Schema.Types.ObjectId,
            ref: 'User',
            required: true,
        },

        text: {
            type: String,
            required: true,
            maxlength: 2000,
        },

        likes: [{
            type: mongoose.Schema.Types.ObjectId,
            ref: 'User',
        }],
    },
    { timestamps: true },
);

const messageSchema = new mongoose.Schema(
    {
        sender: {
            type: mongoose.Schema.Types.ObjectId,
            ref: 'User',
            required: true,
        },

        recipient: {
            type: mongoose.Schema.Types.ObjectId,
            ref: 'User',
            required: true,
        },

        text: {
            type: String,
            required: true,
            maxlength: 5000,
        },

        read: {
            type: Boolean,
            default: false,
        },
    },
    { timestamps: true },
);

module.exports = {
    Comment:
        mongoose.models.Comment ||
        mongoose.model('Comment', commentSchema),

    Message:
        mongoose.models.Message ||
        mongoose.model('Message', messageSchema),
};
